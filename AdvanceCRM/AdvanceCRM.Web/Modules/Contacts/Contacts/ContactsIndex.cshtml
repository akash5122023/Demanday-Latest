@inject Serenity.ITextLocalizer Localizer
@using Microsoft.AspNetCore.Http
@{
     ViewData["Title"] = Localizer.Get("Db.Contacts.Contacts.EntityPlural");
}
@section Head {
    <script>var CKEDITOR_BASEPATH = '@Url.Content("~/Scripts/ckeditor/")';</script>
    @Html.ScriptBundle("CKEditor")
}
<partial name="~/Modules/Common/_GridFilterPanel.cshtml" />

<div id="GridDiv"></div>

<script type="text/javascript">
    jQuery(function () {
        var grid = new AdvanceCRM.Contacts.ContactsGrid($('#GridDiv'), {}).init();
        window.attachGridFilterPanel(grid);
    });
</script>