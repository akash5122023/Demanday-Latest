            }
        });
    }
</script>

<script type="text/javascript">

    $(function () {

        //Enquiry chart
        if (document.getElementById('line-chart-enq') && @Model.EnqListChart.Count() > 0) {
            var line = new Morris.Line({
                element: 'line-chart-enq',
                resize: true,
                data: [
                @{ int cnt = 1;}
                @foreach (var item in Model.EnqListChart.Select(x => x.Date.Value.ToString("yyyy-MM-dd")).Distinct())
                {
                    <text> { y: '@item.ToString()', item1: @Model.EnqListChart.Where(yy => yy.Date.Value.ToString("yyyy-MM-dd") == Html.DisplayFor(x => item).ToString()).Count() }, </text>
                    cnt = cnt + 1;
                }
                ],
                xkey: 'y',
                ykeys: ['item1'],
                labels: ['Count'],
                lineColors: ['#efefef'],
                lineWidth: 2,
                hideHover: 'auto',
                gridTextColor: "#fff",
                gridStrokeWidth: 0.4,
                pointSize: 4,
                pointStrokeColors: ["#efefef"],
                gridLineColor: "#efefef",
                gridTextFamily: "Open Sans",
                gridTextSize: 10
            });
        }

        //Quotation chart
        if (document.getElementById('line-chart-quot') && @Model.QuotListChart.Count() > 0) {
            var line = new Morris.Line({
