<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script type="text/javascript">
    function scrollDashboardSlider(trackId, direction) {
        var track = document.getElementById(trackId);
        if (track) {
            var scrollAmount = track.clientWidth;
            track.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
        }
    }

    function jumpToSlide(trackId, index) {
        var track = document.getElementById(trackId);
        if (track) {
            var scrollAmount = track.clientWidth * index;
            track.scrollTo({ left: scrollAmount, behavior: 'smooth' });
        }
    }

    function updateSliderDots(trackId, dotsId) {
        var track = document.getElementById(trackId);
        var dots = document.getElementById(dotsId);
        if (track && dots) {
            var pageIndex = Math.round(track.scrollLeft / track.clientWidth);
            var dotElements = dots.getElementsByClassName('slider-dot');
            for (var i = 0; i < dotElements.length; i++) {
                if (i === pageIndex) {
                    dotElements[i].classList.add('active');
                } else {
                    dotElements[i].classList.remove('active');
                }
            }
        }
    }

    // Initialize Campaign Performance Chart
    (function () {
        document.addEventListener('DOMContentLoaded', function () {
            var rawData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.QualityPerformanceChartData ?? new System.Collections.Generic.List<AdvanceCRM.Common.QualityChartDataPoint>()));
            
            var labels = rawData.map(function(x) { return x.MonthName; });
            var qualifiedData = rawData.map(function(x) { return x.QualifiedCount; });
            var disqualifiedData = rawData.map(function(x) { return x.DisqualifiedCount; });

            var ctx = document.getElementById('campaignPerformanceChart');
            if (ctx && typeof Chart !== 'undefined') {
                var chartCtx = ctx.getContext('2d');

                var gradientQualified = chartCtx.createLinearGradient(0, 0, 0, 300);
                gradientQualified.addColorStop(0, 'rgba(30, 58, 138, 0.22)');
                gradientQualified.addColorStop(1, 'rgba(30, 58, 138, 0.0)');

                var gradientDisqualified = chartCtx.createLinearGradient(0, 0, 0, 300);
                gradientDisqualified.addColorStop(0, 'rgba(6, 182, 212, 0.18)');
                gradientDisqualified.addColorStop(1, 'rgba(6, 182, 212, 0.0)');

                new Chart(chartCtx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Qualified',
                                data: qualifiedData,
                                borderColor: '#1e3a8a',
                                backgroundColor: gradientQualified,
                                fill: true,
                                tension: 0.4,
                                pointBackgroundColor: '#1e3a8a',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointRadius: 5,
                                pointHoverRadius: 7,
                                borderWidth: 3
                            },
                            {
                                label: 'Disqualified',
                                data: disqualifiedData,
                                borderColor: '#06b6d4',
                                backgroundColor: gradientDisqualified,
                                fill: true,
                                tension: 0.4,
                                pointBackgroundColor: '#06b6d4',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointRadius: 5,
                                pointHoverRadius: 7,
                                borderWidth: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: '#ffffff',
                                titleColor: '#0f172a',
                                bodyColor: '#334155',
                                borderColor: '#e2e8f0',
                                borderWidth: 1,
                                padding: 12,
                                boxPadding: 6,
                                usePointStyle: true,
                                titleFont: { size: 14, weight: 'bold' },
                                bodyFont: { size: 13, weight: '600' },
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ' : ' + context.parsed.y;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    color: '#64748b',
                                    font: { size: 12, weight: '500' }
                                }
                            },
                            y: {
                                grid: {
                                    color: '#f1f5f9'
                                },
                                ticks: {
                                    color: '#64748b',
                                    font: { size: 12, weight: '500' },
                                    precision: 0
                                },
                                beginAtZero: true
                            }
                        }
                    }
                });
            }
        });
    })();
</script>

