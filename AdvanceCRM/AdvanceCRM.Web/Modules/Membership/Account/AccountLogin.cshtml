@inject Serenity.ITextLocalizer Localizer
@inject AdvanceCRM.IDataMigrations DataMigrations
@{
    var welcomeMessage = ViewData["WelcomeMessage"] as string ?? Texts.Forms.Membership.Login.FormTitle;
    ViewData["Title"] = welcomeMessage;
    ViewData["PageId"] = "Login";
    Layout = MVC.Views.Shared._LayoutNoNavigation;
}

@section Head {
    @Html.Script("~/Scripts/vegas/vegas.js")
    @Html.Stylesheet("~/Scripts/vegas/vegas.css")

    <style type="text/css">
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
        }
        body {
            font-family: 'Open Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-size: 14px;
            color: #1f2937;
            -ms-overflow-style: scrollbar;
            background: #ffffff;
        }

        /* Hide the vegas slideshow background that LoginPanel.ts initializes */
        .vegas-overlay, .vegas-slide, .vegas-timer, .vegas-wrapper {
            display: none !important;
        }

        .page-content { padding: 0; margin: 0; }

        /* ===== Split screen layout ===== */
        .login-split {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            overflow: auto;
            background: #ffffff;
            z-index: 9999;
        }

        .login-left, .login-right {
            min-width: 0;
            min-height: 100%;
            box-sizing: border-box;
        }

        /* ----- Left branding panel ----- */
        .login-left {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px 56px;
            color: #ffffff;
            background: radial-gradient(120% 120% at 20% 80%, #5a2a73 0%, rgba(90,42,115,0) 55%),
                        linear-gradient(155deg, #2c2569 0%, #38298a 45%, #4b2e8f 100%);
            overflow: hidden;
        }

        .login-left .brand-logo {
            width: auto;
            align-self: center;
            background: #ffffff;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.25);
            margin-top: 14px;
            margin-bottom: 30px;
            padding: 10px 46px;
            box-sizing: border-box;
        }
        .login-left .brand-logo img {
            height: 90px;
            width: auto;
            max-width: none;
            object-fit: contain;
            display: block;
        }

        .login-left h1 {
            font-size: 34px;
            line-height: 1.15;
            font-weight: 800;
            margin: 0 0 16px 0;
            color: #ffffff;
            letter-spacing: -0.5px;
        }
        .login-left .lead {
            font-size: 15px;
            line-height: 1.55;
            color: rgba(255,255,255,0.82);
            max-width: 540px;
            margin: 0 0 26px 0;
        }

        .feature-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; max-width: 660px; width: 100%; }
        .feature-card {
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 14px;
            padding: 24px 26px;
            text-align: left;
            transition: background .2s ease, transform .2s ease;
        }
        .feature-card:hover { background: rgba(255,255,255,0.12); transform: translateY(-2px); }
        .feature-card .fc-icon { font-size: 20px; color: #f59e0b; margin-bottom: 10px; }
        .feature-card .fc-title { font-size: 15px; font-weight: 700; color: #ffffff; margin-bottom: 4px; }
        .feature-card .fc-sub { font-size: 13px; color: rgba(255,255,255,0.7); }

        /* ----- Right sign-in panel ----- */
        .login-right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 32px;
            background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        }
        .login-card {
            width: 100%;
            max-width: 460px !important;
            min-width: 0;
            margin: 32px 0;
            background: #ffffff;
            border: 1px solid #eef0f4;
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(31, 41, 55, 0.08);
            padding: 44px 44px 36px 44px;
            box-sizing: border-box;
        }
        .login-card .welcome-title { font-size: 30px; font-weight: 800; color: #111827; margin: 0 0 8px 0; letter-spacing: -0.4px; }
        .login-card .welcome-sub { font-size: 15px; color: #6b7280; margin: 0 0 28px 0; }

        /* ===== Neutralize Serenity / jQuery-UI form chrome inside the card ===== */
        #LoginPanel,
        #LoginPanel .flex-layout,
        #LoginPanel form,
        #LoginPanel .s-Form,
        #LoginPanel .s-Form .fieldset,
        #LoginPanel .ui-widget,
        #LoginPanel .ui-widget-content,
        #LoginPanel .s-PropertyGrid,
        #LoginPanel .categories,
        #LoginPanel .category {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }
        #LoginPanel .s-Form .fieldset,
        #LoginPanel .categories,
        #LoginPanel .category {
            padding: 0 !important;
            margin: 0 !important;
            display: block !important;
            height: auto !important;
        }

        /* Hide the widget's own logo + welcome heading (we render our own) */
        #LoginPanel .login-header,
        #LoginPanel h3 { display: none !important; }

        /* Stack each field vertically, full width.
           NOTE: display is intentionally NOT !important so that fields Serenity hides
           (e.g. the [Hidden] "Type" field) stay hidden instead of being forced visible. */
        #LoginPanel .s-Form .field {
            display: block;
            width: 100% !important;
            float: none !important;
            padding: 0 0 20px 0 !important;
            margin: 0 !important;
        }

        /* Keep hidden / explicitly-hidden fields hidden (beats everything above) */
        #LoginPanel .s-Form .field.hidden,
        #LoginPanel .s-Form .field.lp-hide,
        #LoginPanel .s-Form .hidden,
        #LoginPanel .lp-hide { display: none !important; }

        /* Hide Serenity's built-in captions; our own labels are injected via JS */
        #LoginPanel .s-Form .caption,
        #LoginPanel .s-Form label.caption { display: none !important; }

        /* Keep every form container from stretching the card wider than its max-width */
        #LoginPanel,
        #LoginPanel .flex-layout,
        #LoginPanel form,
        #LoginPanel .s-Form,
        #LoginPanel .s-PropertyGrid,
        #LoginPanel .categories,
        #LoginPanel .category,
        #LoginPanel .s-Form .field,
        #LoginPanel .s-Form .fieldset {
            min-width: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        /* Editor wrapper full width + transparent */
        #LoginPanel .s-Form .editor,
        #LoginPanel .s-Form .vx,
        #LoginPanel .s-Form .widget-wrapper {
            display: block !important;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            float: none !important;
            flex: 1 1 100% !important;
            background: transparent !important;
            border: none !important;
        }

        /* Kill background on any stray field child (floating labels etc.) */
        #LoginPanel .s-Form .field > *:not(input):not(.lp-label) { background: transparent !important; }

        /* Our injected label row */
        #LoginPanel .lp-label { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 8px 0; }
        #LoginPanel .lp-label > span { color: #374151; font-weight: 600; font-size: 14px; }
        #LoginPanel .lp-label a.forgot-link { font-size: 13px; font-weight: 600; color: #4338ca; text-decoration: none; }
        #LoginPanel .lp-label a.forgot-link:hover { text-decoration: underline; }

        /* Inputs */
        #LoginPanel .s-Form input,
        #LoginPanel .s-Form input.editor {
            display: block !important;
            width: 100% !important;
            box-sizing: border-box !important;
            padding: 13px 15px !important;
            border: 1px solid #e5e7eb !important;
            border-radius: 10px !important;
            background: #f3f4f6 !important;
            color: #111827 !important;
            font-size: 14px !important;
            box-shadow: none !important;
            text-shadow: none !important;
        }
        #LoginPanel .s-Form input:focus {
            outline: none !important;
            border-color: #4338ca !important;
            background: #ffffff !important;
            box-shadow: 0 0 0 3px rgba(67, 56, 202, 0.12) !important;
        }
        #LoginPanel .s-Form input::placeholder { color: #9ca3af !important; }

        /* Buttons row -> full width primary button */
        #LoginPanel .buttons {
            display: block !important;
            padding: 8px 0 0 0 !important;
            margin: 0 !important;
            text-align: left !important;
        }
        #LoginPanel .buttons .btn,
        #LoginPanel .buttons button {
            display: block !important;
            width: 100% !important;
            padding: 14px 18px !important;
            background: #4338ca !important;
            border: none !important;
            border-radius: 10px !important;
            color: #ffffff !important;
            font-weight: 700 !important;
            font-size: 15px !important;
            cursor: pointer !important;
            box-shadow: 0 8px 20px rgba(67, 56, 202, 0.25) !important;
            text-shadow: none !important;
        }
        #LoginPanel .buttons .btn:hover,
        #LoginPanel .buttons button:hover { background: #3730a3 !important; }

        /* Hide the widget's own actions / powered-by / plan visuals */
        #LoginPanel .actions,
        #LoginPanel .plan-badge,
        #LoginPanel .btn-plan,
        #LoginPanel form div[style*="text-align:center"] { display: none !important; }

        /* ----- Card footer ----- */
        .login-foot {
            margin-top: 24px;
            padding-top: 22px;
            border-top: 1px solid #eef0f4;
            text-align: center;
            font-size: 14px;
            color: #6b7280;
        }
        .login-foot a { color: #4338ca; font-weight: 700; text-decoration: none; }
        .login-foot a:hover { text-decoration: underline; }
        .login-foot, .login-secure { overflow-wrap: break-word; word-wrap: break-word; }
        .login-secure { margin-top: 18px; text-align: center; font-size: 12px; color: #9ca3af; }

        /* ----- Responsive ----- */
        @@media (max-width: 1100px) {
            .login-left { padding: 40px 40px; }
            .login-left h1 { font-size: 32px; }
            .login-right { padding: 32px 24px; }
        }
        @@media (max-width: 820px) {
            .login-split { grid-template-columns: 1fr; }
            .login-left { display: none; }
        }
        @@media (max-width: 520px) {
            .login-right { padding: 20px 14px; }
            .login-card { padding: 30px 22px 26px 22px; }
            .login-card .welcome-title { font-size: 26px; }
        }
    </style>
}

<div class="page-content">
    <div class="login-split">

        <div class="login-left">
            <div class="brand-logo">
                <img src="@Url.Content("~/Content/site/images/demandaylogo.png")" alt="Demanday - Intent Driven" />
            </div>
            <h1>Transform Your Business with Intent-Driven ERP</h1>
            <p class="lead">
                Join thousands of enterprises streamlining operations, boosting productivity,
                and making data-driven decisions with our comprehensive platform.
            </p>

            <div class="feature-cards">
                <div class="feature-card">
                    <div class="fc-icon"><i class="fa fa-bar-chart"></i></div>
                    <div class="fc-title">Advanced Analytics</div>
                    <div class="fc-sub">Real-time insights</div>
                </div>
                <div class="feature-card">
                    <div class="fc-icon"><i class="fa fa-sitemap"></i></div>
                    <div class="fc-title">Smart Workflows</div>
                    <div class="fc-sub">Automate processes</div>
                </div>
                <div class="feature-card">
                    <div class="fc-icon"><i class="fa fa-shield"></i></div>
                    <div class="fc-title">Secure &amp; Compliant</div>
                    <div class="fc-sub">Enterprise-grade security</div>
                </div>
                <div class="feature-card">
                    <div class="fc-icon"><i class="fa fa-users"></i></div>
                    <div class="fc-title">Team Collaboration</div>
                    <div class="fc-sub">Work better together</div>
                </div>
            </div>
        </div>

        <div class="login-right">
            <div class="login-card">
                <h2 class="welcome-title">Welcome back</h2>
                <p class="welcome-sub">Sign in to access your workspace</p>

                <div id="LoginPanel" data-default-welcome="@welcomeMessage"></div>

                <div class="login-foot">
                    Don't have an account? <a href="@Url.Content("~/Account/SignUp")">Request access</a>
                </div>
                <div class="login-secure">
                    Protected by enterprise-grade security &amp; compliance standards
                </div>
            </div>
        </div>

    </div>
</div>

<script type="text/javascript">

jQuery(function () {
    var forgotUrl = '@Url.Content("~/Account/ForgotPassword")';

    function addLabel($input, text, placeholder, extraHtml) {
        if (!$input || !$input.length) return;
        $input.attr('placeholder', placeholder);
        var $field = $input.closest('.field');
        if (!$field.length) $field = $input.parent();
        $field.find('.lp-label').remove();
        var $lbl = $('<div class="lp-label"></div>');
        $('<span></span>').text(text).appendTo($lbl);
        if (extraHtml) $lbl.append(extraHtml);
        $field.prepend($lbl);
    }

    function enhanceLoginPanel(panel) {
        var $p = $('#LoginPanel');

        var $pass = $p.find('input[type=password]').first();
        var $user = $p.find('input[type=text], input:not([type])').not('[type=hidden]').first();
        var userEl = $user[0], passEl = $pass[0];

        // Hide every field that is NOT the email or password field (e.g. the unused
        // "Type" field that renders as a blank box). Field-based + native contains()
        // so it works regardless of the editor type inside.
        if (userEl && passEl) {
            $p.find('.s-Form .field').each(function () {
                if (this.contains(userEl) || this.contains(passEl)) return;
                $(this).addClass('lp-hide');
            });
        }
        // Belt-and-suspenders: hide any leftover stray input directly.
        $p.find('.s-Form input').each(function () {
            if (this === userEl || this === passEl || this.type === 'hidden') return;
            if (!$(this).closest('.field').length) $(this).addClass('lp-hide');
        });

        addLabel($user, 'Username', 'Enter your username');
        addLabel($pass, 'Password', 'Enter your password',
            $('<a/>', { 'class': 'forgot-link', href: forgotUrl, text: 'Forgot password?' }));

        var $btn = $p.find('.buttons button, .buttons .btn').first();
        if ($btn.length) $btn.text('Sign in to Dashboard');
    }

    function initLoginPanel() {
        if (window.AdvanceCRM && AdvanceCRM.Membership && AdvanceCRM.Membership.LoginPanel) {
            var loginPanel = new AdvanceCRM.Membership.LoginPanel($('#LoginPanel')).init();
            enhanceLoginPanel(loginPanel);
@if (ViewData["Activated"] != null)
{
            <text>
            loginPanel.byId('Username').val(@Html.Raw(Serenity.JSON.Stringify(ViewData["Activated"])));
            loginPanel.byId('Password').focus();
            </text>
}
        } else {
            setTimeout(initLoginPanel, 50);
        }
    }
    initLoginPanel();
});
</script>
