@inject Serenity.ITextLocalizer Localizer
@{
    ViewData["Title"] = Localizer.Get("Db.Demanday.DemandayQuality.EntityPlural");
}

<partial name="~/Modules/Common/_GridFilterPanel.cshtml" />
<partial name="~/Modules/Common/_GridSummaryBar.cshtml" />

<div id="GridDiv"></div>

<script type="text/javascript">
    jQuery(function () {
        var grid = new AdvanceCRM.Demanday.DemandayQualityGrid($('#GridDiv'), {}).init();
        window.attachGridFilterPanel(grid);
        // Added after the filter panel so the summary lands above the whole grid layout.
        window.attachGridSummaryBar(grid, {
            title: 'Quality',
            mode: 'chips',
            url: 'Demanday/DemandayQuality/QaStatusSummary',
            field: 'QaStatus',
            storageKey: 'etQuality'
        });
    });
</script>