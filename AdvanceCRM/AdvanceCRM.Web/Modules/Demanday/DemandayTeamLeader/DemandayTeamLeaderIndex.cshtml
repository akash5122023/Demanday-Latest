@inject Serenity.ITextLocalizer Localizer
@{
    ViewData["Title"] = Localizer.Get("Db.Demanday.DemandayTeamLeader.EntityPlural");
}

<partial name="~/Modules/Common/_GridFilterPanel.cshtml" />
<partial name="~/Modules/Common/_GridSummaryBar.cshtml" />

<div id="GridDiv"></div>

<script type="text/javascript">
    jQuery(function () {
        var grid = new AdvanceCRM.Demanday.DemandayTeamLeaderGrid($('#GridDiv'), {}).init();
        window.attachGridFilterPanel(grid);
        // Added after the filter panel so the summary lands above the whole grid layout.
        window.attachGridSummaryBar(grid, {
            title: 'Team Leader',
            mode: 'table',
            url: 'Demanday/DemandayTeamLeader/AccountCampaignSummary',
            accountField: 'MasterAccountId',
            campaignField: 'CampaignId',
            storageKey: 'etTeamLeader'
        });
    });
</script>